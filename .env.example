# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=changeme

# Async SQLAlchemy URL (used by the backend directly)
DATABASE_URL=postgresql+asyncpg://authuser:changeme@localhost:5432/authdb

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
AUTH_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_KEY_ID=auth-key-1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ── OAuth — Google ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — Microsoft ───────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Application ──────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Seed admin account ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# ── Production flags ─────────────────────────────────────────────────────────
# Set to true in production to disable /docs and /redoc (enforces strictest CSP)
DISABLE_SWAGGER=false
